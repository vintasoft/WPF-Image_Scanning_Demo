<Window x:Class="WpfImageScanningDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfImageScanningDemo"
        mc:Ignorable="d"
        Title="VintaSoft WPF Image Scanning Demo" Width="640" Height="800" MinWidth="640" MinHeight="800" Closing="Window_Closing" ContentRendered="Window_ContentRendered">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="top" Orientation="Vertical" HorizontalAlignment="Left" Margin="15,0,-13,0" >
            <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Left" >
                <Label Content="Devices:" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <ComboBox Name="devicesComboBox" HorizontalAlignment="Left" Margin="30,2,0,0" VerticalAlignment="Top" Width="510" SelectionChanged="devicesComboBox_SelectionChanged"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Left" >
                <CheckBox Name="showDeviceUiCheckBox" Content="Show Device UI" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Top"/>
                <CheckBox Name="useDocumentFeederCheckBox" Content="Use the document feeder" HorizontalAlignment="Left" Margin="40,0,0,0" VerticalAlignment="Top"/>
                <CheckBox Name="useDuplexScanningCheckBox" Content="Use duplex scanning" HorizontalAlignment="Left" Margin="50,0,0,0" VerticalAlignment="Top"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Left" >
                <Label Content="Image pixel type:" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <ComboBox Name="imagePixelTypesComboBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,3,0,0" Width="179"/>
                <Label Content="Image resoluton:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,0,0,0"/>
                <ComboBox Name="imageResolutionsComboBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,2,0,0" Width="179"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Left" >
                <Label Content="Page size:" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <ComboBox Name="pageSizesComboBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="179" Margin="44,3,0,0"/>
                <Label Content="Image encoder:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,0,0,0"/>
                <ComboBox Name="imageEncodersComboBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="11,2,0,0" Width="179"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Left" >
                <Button Name="scanImagesButton" Content="Scan images" HorizontalAlignment="Center" VerticalAlignment="Top" Height="34" Width="590" Click="scanImagesButton_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" HorizontalAlignment="Left" Margin="15,0,0,10" Width="600" >
            <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Left" >
                <Label Name="scannedImagesInfoLabel" Content="" HorizontalAlignment="Center" VerticalAlignment="Center" Width="106" Height="23" Margin="238,0,0,0"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal" HorizontalAlignment="Left" >
                <Button Name="previousImageButton" Content="Previous image" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Click="previousImageButton_Click"/>
                <Button Name="nextImageButton" Content="Next image" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Top" Width="100" Click="nextImageButton_Click"/>
                <Button Name="saveImageButton" Content="Save image" HorizontalAlignment="Center" Margin="20,0,0,0" VerticalAlignment="Top" Width="100" Click="saveImageButton_Click"/>
                <Button Name="saveAllImagesButton" Content="Save images" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Top" Width="100" Click="saveImagesButton_Click"/>
                <Button Name="deleteAllImagesButton" Content="Delete images" HorizontalAlignment="Center" Margin="20,0,0,0" VerticalAlignment="Top" Width="100" Click="deleteImagesButton_Click"/>
            </StackPanel>
        </StackPanel>

        <Border BorderThickness="1" BorderBrush="Black">
            <Image Name="scannedImage" Stretch="Fill" />
        </Border>
    </DockPanel>
</Window>
